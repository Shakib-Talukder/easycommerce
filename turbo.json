{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "ADMIN_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "REDIS_URL",
    "ROOT_DOMAIN",
    "JWT_SECRET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMS_PROVIDER",
    "OTP_TTL_SECONDS",
    "STORAGE_PROVIDER",
    "LOCAL_UPLOAD_DIR",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_OBJECT_ACL",
    "ASSET_PUBLIC_BASE_URL",
    "SMS_API_KEY",
    "SMS_SENDER_ID",
    "SMTP_FROM",
    "SMTP_USER",
    "SMTP_PASSWORD"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**"],
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false
    }
  }
}
