{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "ADMIN_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "REDIS_URL",
    "ROOT_DOMAIN",
    "JWT_SECRET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMS_PROVIDER",
    "OTP_TTL_SECONDS"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**"],
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false
    }
  }
}
