{
  "name": "easycommerce",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:up:local": "pnpm --filter @repo/db db:local",
    "redis:up:local": "pnpm --filter @repo/core redis:local",
    "storage:sweep": "pnpm --filter @repo/core storage:sweep",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:studio": "pnpm --filter @repo/db db:studio"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "prettier": "3.7.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
