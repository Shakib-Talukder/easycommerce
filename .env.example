# --- PostgreSQL (docker compose or `pnpm db:up:local`) ---
# Owner role: migrations, seed, Prisma Studio.
DATABASE_URL="postgresql://ecom_owner:ecom_owner@localhost:5432/easycommerce"
# Optional: leave unset and Prisma creates a temporary shadow DB itself (owner has CREATEDB).
SHADOW_DATABASE_URL=""
# Runtime tenant role (RLS enforced).
APP_DATABASE_URL="postgresql://app_user:app_user@localhost:5432/easycommerce"
# Platform admin / store-by-host lookup (BYPASSRLS).
ADMIN_DATABASE_URL="postgresql://app_admin:app_admin@localhost:5432/easycommerce"

# --- Redis ---
# Rate limits, signup OTPs, signup handoff tokens. Required when NODE_ENV=production.
# Dev without Docker: `pnpm redis:up:local` (small RESP server) or leave it down to use the in-memory fallback.
REDIS_URL="redis://127.0.0.1:6379"

# --- Tenancy ---
# Stores are served at <subdomain>.<ROOT_DOMAIN>. *.localhost resolves to 127.0.0.1 in modern browsers.
ROOT_DOMAIN="localhost:3000"

# --- Auth ---
# At least 32 random chars: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
OTP_TTL_SECONDS=300

# --- Messaging ---
# Mailpit in dev. If SMTP is unreachable in development, emails are printed to the console.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="EasyCommerce <no-reply@easycommerce.local>"
# SMTP_USER=""
# SMTP_PASSWORD=""
# console (prints OTPs to the server log) | bulksmsbd (typed stub, not wired yet)
SMS_PROVIDER="console"
# SMS_API_KEY=""
# SMS_SENDER_ID=""
