# --- PostgreSQL (docker compose or `pnpm db:up:local`) ---
# Owner role: migrations, seed, Prisma Studio.
DATABASE_URL="postgresql://ecom_owner:ecom_owner@localhost:5432/easycommerce"
# Optional: leave unset and Prisma creates a temporary shadow DB itself (owner has CREATEDB).
SHADOW_DATABASE_URL=""
# Runtime tenant role (RLS enforced).
APP_DATABASE_URL="postgresql://app_user:app_user@localhost:5432/easycommerce"
# Platform admin / store-by-host lookup (BYPASSRLS).
ADMIN_DATABASE_URL="postgresql://app_admin:app_admin@localhost:5432/easycommerce"

# --- Redis ---
# Rate limits, signup OTPs, signup handoff tokens. Required when NODE_ENV=production.
# Dev without Docker: `pnpm redis:up:local` (small RESP server) or leave it down to use the in-memory fallback.
REDIS_URL="redis://127.0.0.1:6379"

# --- Tenancy ---
# Stores are served at <subdomain>.<ROOT_DOMAIN>. *.localhost resolves to 127.0.0.1 in modern browsers.
ROOT_DOMAIN="localhost:3000"

# --- Auth ---
# At least 32 random chars: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
OTP_TTL_SECONDS=300

# --- Messaging ---
# Mailpit in dev. If SMTP is unreachable in development, emails are printed to the console.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="EasyCommerce <no-reply@easycommerce.local>"
# SMTP_USER=""
# SMTP_PASSWORD=""
# console (prints OTPs to the server log) | bulksmsbd (BulkSMSBD HTTP API)
SMS_PROVIDER="console"
# Production (NODE_ENV=production, incl. a local `next start`) refuses SMS_PROVIDER=console
# unless this is "true". Never set it on a public deployment.
# ALLOW_CONSOLE_SMS="true"
# SMS_API_KEY=""
# SMS_SENDER_ID=""          # approved sender ID / masking name from the BulkSMSBD panel
# SMS_API_URL="https://bulksmsbd.net/api/smsapi"
# SMS_TEST_NUMBER=""        # opt-in live test: one SMS goes to this number when SMS_API_KEY is set

# --- Object storage (logos now, product images later) ---
# local: files under apps/web/public/uploads, served by /api/uploads/… (dev and `next start` on localhost only;
#        refused in production with a real ROOT_DOMAIN).
# s3:    any S3-compatible store (Cloudflare R2, DigitalOcean Spaces). See README "Object storage".
STORAGE_PROVIDER="local"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="easycommerce-assets"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# S3_OBJECT_ACL=""            # Spaces without a public CDN: "public-read". R2: leave empty.
# ASSET_PUBLIC_BASE_URL="https://cdn.example.com"
