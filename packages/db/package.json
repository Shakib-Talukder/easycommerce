{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./host": "./src/host.ts",
    "./money": "./src/money.ts",
    "./validation": "./src/validation.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "tsx scripts/local-postgres.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@repo/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "embedded-postgres": "16.15.0-beta.19",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
