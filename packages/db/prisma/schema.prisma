// Multi-tenant e-commerce schema (PostgreSQL 16).
//
// Conventions for every tenant table:
// - `id` is a cuid2 string; `storeId` maps to `store_id` and is indexed.
// - Every unique constraint is composite with store_id.
// - Money is integer poisha (1 BDT = 100 poisha). Never floats.
// - Row-Level Security policies, CHECK constraints and extensions live in the
//   migration SQL (Prisma does not model them).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StoreStatus {
  ACTIVE
  SUSPENDED
  PENDING

  @@map("store_status")
}

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

enum Language {
  bn
  en

  @@map("language")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@map("order_status")
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED

  @@map("payment_status")
}

enum WalletAccountType {
  PERSONAL
  AGENT
  MERCHANT

  @@map("wallet_account_type")
}

enum OtpPurpose {
  LOGIN
  INVITE

  @@map("otp_purpose")
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Store {
  id           String      @id @default(cuid(2))
  /// Display names; pick one with storeDisplayName(store, locale).
  nameBn       String      @map("name_bn")
  nameEn       String      @map("name_en")
  /// lowercase, 3–30 chars, [a-z0-9-]; enforced by zod + CHECK constraint
  subdomain    String      @unique @db.VarChar(30)
  customDomain String?     @unique @map("custom_domain") @db.Citext
  status       StoreStatus @default(PENDING)
  plan         String      @default("free")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings      StoreSettings?
  users         User[]
  categories    Category[]
  products      Product[]
  variants      Variant[]
  customers     Customer[]
  orders        Order[]
  orderItems    OrderItem[]
  productImages ProductImage[]
  otpCodes      OtpCode[]
  sessions      Session[]

  @@map("stores")
}

// ---------------------------------------------------------------------------
// Tenant tables
// ---------------------------------------------------------------------------

model User {
  id          String    @id @default(cuid(2))
  storeId     String    @map("store_id")
  name        String
  email       String?   @db.Citext
  /// E.164, e.g. +8801XXXXXXXXX
  phone       String?   @db.VarChar(16)
  role        UserRole  @default(STAFF)
  /// Admin UI language.
  locale      Language  @default(bn)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([storeId, email])
  @@unique([storeId, phone])
  @@index([storeId])
  @@map("users")
}

model StoreSettings {
  id                         String             @id @default(cuid(2))
  storeId                    String             @unique @map("store_id")
  /// Wizard steps completed (0–4); the wizard resumes at onboardingStep + 1.
  onboardingStep             Int                @default(0) @map("onboarding_step") @db.SmallInt
  onboardingCompletedAt      DateTime?          @map("onboarding_completed_at") @db.Timestamptz(3)
  taglineBn                  String?            @map("tagline_bn")
  taglineEn                  String?            @map("tagline_en")
  /// Object-storage keys (always under stores/<storeId>/) and their public URLs.
  logoKey                    String?            @map("logo_key")
  logoUrl                    String?            @map("logo_url")
  faviconKey                 String?            @map("favicon_key")
  faviconUrl                 String?            @map("favicon_url")
  /// #rrggbb
  primaryColor               String             @default("#16a34a") @map("primary_color") @db.VarChar(7)
  /// #rrggbb
  secondaryColor             String?            @map("secondary_color") @db.VarChar(7)
  currency                   String             @default("BDT") @db.Char(3)
  /// Storefront default language.
  language                   Language           @default(bn)
  contactPhone               String?            @map("contact_phone") @db.VarChar(16)
  contactEmail               String?            @map("contact_email") @db.Citext
  /// Division and district ids from packages/core/data/bd-locations.json.
  addressDivision            String?            @map("address_division")
  addressDistrict            String?            @map("address_district")
  addressArea                String?            @map("address_area")
  /// Street address line.
  address                    String?
  codEnabled                 Boolean            @default(true) @map("cod_enabled")
  bkashEnabled               Boolean            @default(false) @map("bkash_enabled")
  /// E.164
  bkashNumber                String?            @map("bkash_number") @db.VarChar(16)
  bkashAccountType           WalletAccountType? @map("bkash_account_type")
  nagadEnabled               Boolean            @default(false) @map("nagad_enabled")
  /// E.164
  nagadNumber                String?            @map("nagad_number") @db.VarChar(16)
  nagadAccountType           WalletAccountType? @map("nagad_account_type")
  /// poisha
  deliveryChargeInsideDhaka  Int                @default(6000) @map("delivery_charge_inside_dhaka")
  /// poisha
  deliveryChargeOutsideDhaka Int                @default(12000) @map("delivery_charge_outside_dhaka")
  /// poisha; orders at or above this subtotal ship free
  freeDeliveryThreshold      Int?               @map("free_delivery_threshold")
  deliveryDaysInsideDhaka    Int?               @map("delivery_days_inside_dhaka") @db.SmallInt
  deliveryDaysOutsideDhaka   Int?               @map("delivery_days_outside_dhaka") @db.SmallInt
  socialLinks                Json               @default("{}") @map("social_links")
  seo                        Json               @default("{}")
  /// Last issued order number; incremented atomically by nextOrderNumber().
  orderSeq                   Int                @default(1000) @map("order_seq")
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model Category {
  id            String    @id @default(cuid(2))
  storeId       String    @map("store_id")
  nameBn        String    @map("name_bn")
  nameEn        String    @map("name_en")
  /// lowercase a-z0-9-, unique per store among non-deleted rows
  slug          String
  descriptionBn String?   @map("description_bn")
  descriptionEn String?   @map("description_en")
  /// Max depth 2: a category with a parent can't have children (code + trigger).
  parentId      String?   @map("parent_id")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Object-storage key under stores/<storeId>/category/ and its public URL.
  imageKey      String?   @map("image_key")
  imageUrl      String?   @map("image_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug], map: "categories_store_id_slug_key", where: raw("deleted_at IS NULL"))
  @@index([storeId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String        @id @default(cuid(2))
  storeId       String        @map("store_id")
  categoryId    String?       @map("category_id")
  titleBn       String        @map("title_bn")
  titleEn       String        @map("title_en")
  slug          String
  /// Plain text with line breaks, at most 5000 characters.
  descriptionBn String?       @map("description_bn")
  descriptionEn String?       @map("description_en")
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false) @map("is_featured")
  /// Position among featured products (ascending); null when not featured.
  featuredOrder Int?          @map("featured_order")
  /// Option axes: [{ key: "size" | "colour", values: [{ id, bn, en, hex? }] }], at most 2 axes x 20 values.
  options       Json          @default("[]")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   Variant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@unique([storeId, slug], map: "products_store_id_slug_key", where: raw("deleted_at IS NULL"))
  @@index([storeId])
  @@index([storeId, status])
  @@index([categoryId])
  @@map("products")
}

/// Every product has at least one variant; a simple product has one with empty option_values.
model Variant {
  id           String    @id @default(cuid(2))
  storeId      String    @map("store_id")
  productId    String    @map("product_id")
  sku          String
  /// { size?: valueId, colour?: valueId } referencing products.options.
  optionValues Json      @default("{}") @map("option_values")
  /// "<size value id>|<colour value id>", derived from option_values (CHECK); unique per product.
  optionKey    String    @default("|") @map("option_key")
  /// Regular price, poisha.
  price        Int
  /// Sale price, poisha; must be below price.
  salePrice    Int?      @map("sale_price")
  stock        Int       @default(0)
  weightGrams  Int?      @map("weight_grams")
  /// The image shown for this variant (e.g. the red photo); same product only.
  imageId      String?   @map("image_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@unique([storeId, sku], map: "variants_store_id_sku_key", where: raw("deleted_at IS NULL"))
  @@unique([storeId, productId, optionKey], map: "variants_product_option_key", where: raw("deleted_at IS NULL"))
  @@index([storeId])
  @@index([productId])
  @@index([imageId])
  @@map("variants")
}

/// Product photos (1600 px WebP + 400 px thumb). The first by sort_order is the cover.
model ProductImage {
  id        String   @id @default(cuid(2))
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  /// Keys under stores/<storeId>/product/ (CHECK).
  key       String
  thumbKey  String   @map("thumb_key")
  url       String
  thumbUrl  String   @map("thumb_url")
  width     Int
  height    Int
  altBn     String?  @map("alt_bn")
  altEn     String?  @map("alt_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@index([storeId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Customer {
  id          String    @id @default(cuid(2))
  storeId     String    @map("store_id")
  name        String
  /// E.164
  phone       String    @db.VarChar(16)
  email       String?   @db.Citext
  division    String?
  district    String?
  area        String?
  addressLine String?   @map("address_line")
  totalOrders Int       @default(0) @map("total_orders")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

model Order {
  id              String        @id @default(cuid(2))
  storeId         String        @map("store_id")
  customerId      String?       @map("customer_id")
  /// Human-readable, sequential per store (e.g. "1001").
  orderNumber     String        @map("order_number") @db.VarChar(20)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  currency        String        @default("BDT") @db.Char(3)
  /// poisha
  subtotal        Int
  /// poisha
  deliveryCharge  Int           @default(0) @map("delivery_charge")
  /// poisha
  discount        Int           @default(0)
  /// poisha
  total           Int
  /// Snapshot at order time: { name, phone, division, district, area, line }
  shippingAddress Json          @map("shipping_address")
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid(2))
  storeId   String   @map("store_id")
  orderId   String   @map("order_id")
  productId String?  @map("product_id")
  variantId String?  @map("variant_id")
  /// Snapshots so history survives product edits/deletes.
  title     String
  sku       String?
  options   Json     @default("{}")
  /// poisha
  unitPrice Int      @map("unit_price")
  quantity  Int
  /// poisha
  lineTotal Int      @map("line_total")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// One-time codes for merchant login and staff invites. Only the HMAC of the
/// code is stored. Store signup codes live in the KeyValueStore instead,
/// because the store does not exist yet.
model OtpCode {
  id         String     @id @default(cuid(2))
  storeId    String     @map("store_id")
  /// Normalised email (lowercase) or E.164 phone.
  identifier String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, identifier, purpose])
  @@map("otp_codes")
}

/// Server-side record for each session JWT (`sid` claim = id). Revoking sets revokedAt.
model Session {
  id         String    @id @default(cuid(2))
  storeId    String    @map("store_id")
  userId     String    @map("user_id")
  /// sha256 of the most recently issued JWT for this session.
  tokenHash  String    @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, userId])
  @@map("sessions")
}
